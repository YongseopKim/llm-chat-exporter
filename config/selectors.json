{
  "version": "1.0.0",
  "lastUpdated": "2026-10-02",
  "platforms": {
    "chatgpt": {
      "hostname": "chatgpt.com",
      "selectors": {
        "messages": {
          "primary": "[data-turn]",
          "fallbacks": [
            "[data-content-search-unit-key]",
            "[data-message-author-role]",
            "article[data-testid^=\"conversation\"]"
          ]
        },
        "content": {
          "user": ".whitespace-pre-wrap, .markdown",
          "assistant": ".markdown, [data-markdown-text-style=\"assistant-message\"]",
          "attachment": "[data-testid=\"library-file-icon\"]"
        },
        "generation": "button[aria-label*=\"Stop\"]",
        "role": {
          "strategy": "attribute",
          "attributes": ["data-message-author-role", "data-turn"]
        },
        "title": {
          "strategy": "document-title",
          "prefixPattern": "^ChatGPT\\s*[-–—]\\s*",
          "emojiPattern": "^[\\p{Emoji_Presentation}\\p{Extended_Pictographic}]\\s*"
        }
      }
    },
    "gemini": {
      "hostname": "gemini.google.com",
      "selectors": {
        "messages": {
          "combined": "user-query, model-response"
        },
        "content": {
          "user": ".query-text",
          "assistant": ".response-container-content"
        },
        "generation": "button[aria-label*=\"Stop\"]",
        "role": {
          "strategy": "tagname",
          "userTag": "user-query",
          "assistantTag": "model-response"
        },
        "title": {
          "strategy": "selector",
          "selector": "span.conversation-title",
          "emojiPattern": "^[\\p{Emoji}\\p{Emoji_Presentation}\\p{Extended_Pictographic}][\\uFE0E\\uFE0F]?\\s*"
        }
      }
    },
    "grok": {
      "hostname": "grok.com",
      "selectors": {
        "messages": {
          "primary": ".message-bubble"
        },
        "content": {
          "user": ".message-bubble",
          "assistant": ".message-bubble"
        },
        "generation": "",
        "role": {
          "strategy": "sibling-button",
          "userMarker": "button[aria-label='Edit'], button[aria-label='편집']",
          "assistantMarker": "button[aria-label='Regenerate'], button[aria-label='다시 생성']"
        },
        "title": {
          "strategy": "document-title",
          "suffixPattern": "\\s*[-–—]\\s*Grok$",
          "emojiPattern": "^[\\p{Emoji_Presentation}\\p{Extended_Pictographic}]\\s*"
        }
      }
    },
    "surf": {
      "hostname": "asksurf.ai",
      "selectors": {
        "messages": { "combined": "#surf-root .justify-start, #surf-root [data-markdown-renderer]" },
        "content": { "user": ".justify-start", "assistant": "[data-markdown-renderer]" },
        "generation": "#surf-root button[aria-label=\"Stop\"], #surf-root button[aria-label=\"Stop generating\"]",
        "role": {
          "strategy": "combined-selector",
          "userSelector": "#surf-root .justify-start",
          "assistantSelector": "#surf-root [data-markdown-renderer]"
        },
        "title": { "strategy": "document-title" }
      }
    },
    "perplexity": {
      "hostname": "perplexity.ai",
      "selectors": {
        "messages": {
          "combined": "main span.select-text, main div.prose[data-renderer='lm']"
        },
        "content": {
          "user": "span.select-text",
          "assistant": "div.prose[data-renderer='lm']"
        },
        "generation": "",
        "role": {
          "strategy": "combined-selector",
          "userSelector": "main span.select-text",
          "assistantSelector": "main div.prose[data-renderer='lm']"
        },
        "title": {
          "strategy": "document-title",
          "suffixPattern": "\\s*[-–—]\\s*Perplexity$",
          "emojiPattern": "^[\\p{Emoji_Presentation}\\p{Extended_Pictographic}]\\s*"
        }
      }
    }
  }
}
